  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main",
    "lint": "oxlint --fix src test",
    "lint:check": "oxlint src test",
    "migrate:email-index": "ts-node -r tsconfig-paths/register src/scripts/migrate-email-index.ts",
    "migrate:multitenant": "ts-node -r tsconfig-paths/register src/scripts/migrate-multitenant.ts",
    "init:neo4j": "ts-node -r tsconfig-paths/register src/scripts/init-neo4j.ts",

    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
